{
  "name": "team17-math-rpg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest run ui.test.ts --reporter=verbose",
    "test:watch": "vitest",
    "build:ui": "node scripts/build-ui.mjs",
    "typecheck:ui": "tsc --noEmit -p tsconfig.ui.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "happy-dom": "21.0.4",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.0.0"
  }
}
